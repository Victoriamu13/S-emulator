<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>


<HBox spacing="10.0" xmlns="http://javafx.com/javafx/"
       xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uiDisplay.components.programFeatures.ProgUpperControlsController"
      stylesheets="@/skins/base.css">

   <children>
      <ComboBox fx:id="programSelector" promptText="Select Program/Function" prefWidth="150.0" />
      <Button fx:id="btnCollapse" text="Collapse" />
      <Label fx:id="lblDegree" text="0 / 0" styleClass="dynamic-label"/>
      <Button fx:id="btnExpand" text="Expand" />
      <ComboBox fx:id="highlightSelector" promptText="Highlight" prefWidth="150.0"/>
   </children>
   <padding>
      <Insets top="8.0" />
   </padding>
</HBox>
