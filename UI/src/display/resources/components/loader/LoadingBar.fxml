<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/"
      xmlns:fx="http://javafx.com/fxml/"
      fx:controller="uiDisplay.components.load.LoadingBarController"
      spacing="8"
      alignment="CENTER"
      stylesheets="@/components/loader/Loader.css">

    <padding>
        <Insets top="10" right="20" bottom="15" left="20"/>
    </padding>

    <children>

    <HBox spacing="10" alignment="CENTER">
    <children>

        <Label fx:id="lblLoading"
               text="Load Progress : 0%"
               styleClass="dynamic-label"/>

        <ProgressBar fx:id="progressBar"
                     prefWidth="500"
                     prefHeight="18"
                     progress="0.0"
                     styleClass="custom-progress-bar"/>
    </children>
    </HBox>

    </children>
</VBox>