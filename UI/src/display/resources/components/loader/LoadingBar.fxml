<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.CheckBox?>
<VBox xmlns="http://javafx.com/javafx/"
      xmlns:fx="http://javafx.com/fxml/"
      fx:controller="uiDisplay.components.load.LoadingBarController"
      spacing="8"
      alignment="CENTER"
      stylesheets="@/skins/base.css">

    <padding>
        <Insets top="10" right="20" bottom="15" left="20"/>
    </padding>

    <children>

    <HBox spacing="10" alignment="CENTER">
    <children>
        <ComboBox fx:id="skinSelector" promptText="Select Skin" prefWidth="150.0"/>
        <Region prefWidth="30"/>
        <Label text="Animations:" styleClass="dynamic-label"/>
        <CheckBox fx:id="wthAnimations" text="Enable" selected="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblLoading"
               text="Load Progress : 0%"
               styleClass="dynamic-label"/>

        <ProgressBar fx:id="progressBar"
                     prefWidth="500"
                     prefHeight="18"
                     progress="0.0"/>
    </children>
    </HBox>

    </children>
</VBox>