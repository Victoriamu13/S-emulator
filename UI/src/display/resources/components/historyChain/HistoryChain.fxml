<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uiDisplay.components.HistoryChainController"
      spacing="8"
      stylesheets="@/components/instructions/Instructions.css">

  <padding>
    <Insets top="10" right="10" bottom="10" left="10"/>
  </padding>

  <children>
    <Label text="History Chain"
           styleClass="section-title"
           maxWidth="Infinity"/>

    <TableView fx:id="historyChainTable" VBox.vgrow="ALWAYS">
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>

      <columns>
        <TableColumn fx:id="colIdx"    text="#" />
        <TableColumn fx:id="colBS"     text="B/S" />
        <TableColumn fx:id="colLabel"  text="Label" />
        <TableColumn fx:id="colInstr"  text="Instruction" />
        <TableColumn fx:id="colCycles" text="Cycles" />
      </columns>
    </TableView>
  </children>
</VBox>
