<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>


<VBox  xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml" >
   <children>
      <TableView  VBox.vgrow="ALWAYS" >
          <columnResizePolicy >
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        <columns>
          <TableColumn prefWidth="75.0" text="User Name" />
          <TableColumn prefWidth="75.0" text="Programs Uploaded" />
            <TableColumn prefWidth="75.0" text="Functions Contributed" />
            <TableColumn prefWidth="75.0" text="Current Credits" />
            <TableColumn prefWidth="75.0" text="Credits Used" />
            <TableColumn prefWidth="75.0" text="Total Executions (Run + Debug)" />
        </columns>
      </TableView>
      <Button mnemonicParsing="false" text="Unselect User" />
   </children>
</VBox>
