<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<TableView xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml">
  <columnResizePolicy >
    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
  </columnResizePolicy>
  <columns>
    <TableColumn prefWidth="75.0" text="Run Number" />
    <TableColumn prefWidth="75.0" text="Run Type" />
      <TableColumn prefWidth="75.0" text="Program / Function" />
      <TableColumn prefWidth="75.0" text="Architecture Type" />
      <TableColumn prefWidth="75.0" text="Run Level" />
      <TableColumn prefWidth="75.0" text="Y Value" />
      <TableColumn prefWidth="75.0" text="Cycles" />
  </columns>
</TableView>
