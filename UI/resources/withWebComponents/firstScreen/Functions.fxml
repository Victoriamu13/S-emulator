<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>


<VBox  xmlns="http://javafx.com/javafx/"  xmlns:fx="http://javafx.com/fxml"
       fx:controller="controllers.components.instructions.FunctionsController" >
   <children>
      <TableView fx:id="FunctionsTable"   VBox.vgrow="ALWAYS">
          <columnResizePolicy >
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        <columns>
          <TableColumn prefWidth="75.0" text="Function " />
          <TableColumn prefWidth="75.0" text="Parent Program" />
            <TableColumn prefWidth="75.0" text="Uploaded By" />
            <TableColumn prefWidth="75.0" text="Instructions Count (Degree 0)" />
            <TableColumn prefWidth="75.0" text="Max Degree" />
        </columns>
      </TableView>
      <Button mnemonicParsing="false" text="Execute Program" alignment="TOP_RIGHT"/>
   </children>
</VBox>
