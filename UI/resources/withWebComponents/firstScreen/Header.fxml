<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.components.load.HeaderController"
      spacing="10" alignment="CENTER">

    <!-- ==== Row 1: User / Title / Credits ==== -->
    <HBox spacing="15" alignment="CENTER" >
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <children>
            <Label text="User Name:"  maxWidth="Infinity" HBox.hgrow="NEVER"/>
            <TextField fx:id="userNameField" prefWidth="120"  editable="false" HBox.hgrow="NEVER"/>

            <Label text="S-Emulator — Dashboard"  maxWidth="Infinity" HBox.hgrow="NEVER"/>

            <Label text="Available Credits:"  maxWidth="Infinity"/>
            <TextField fx:id="creditsField" prefWidth="80" promptText="credits"  editable="false" HBox.hgrow="NEVER"/>
        </children>
    </HBox>

    <!-- ==== Row 2: Load file + Credits ==== -->
    <HBox spacing="10" alignment="CENTER" >
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <children>
            <Button fx:id="btnLoadFile" text="Load File Button" HBox.hgrow="NEVER"/>
            <TextField fx:id="filePathField" prefWidth="250" text="Currently Loaded File path"  editable="false" HBox.hgrow="NEVER"/>

            <Button fx:id="btnAdd500Credits" text="+500 Credits" HBox.hgrow="NEVER"/>
            <Button fx:id="btnChargeCredits" text="Charge Credits" HBox.hgrow="NEVER"/>
            <TextField fx:id="creditsInputField" text=""  prefWidth="60" HBox.hgrow="NEVER"/>
        </children>
    </HBox>

    <Label fx:id="loadStatusLabel" text="" style="-fx-font-size: 13px;"/>
</VBox>