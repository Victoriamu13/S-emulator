<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/">
   <children>
      <TableView xmlns:fx="http://javafx.com/fxml"   VBox.vgrow="ALWAYS">
          <columnResizePolicy >
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        <columns>
          <TableColumn prefWidth="75.0" text="Name" />
          <TableColumn prefWidth="75.0" text="Uploaded By" />
            <TableColumn prefWidth="75.0" text="Instructions Count (Degree 0)" />
            <TableColumn prefWidth="75.0" text="Max Degree" />
            <TableColumn prefWidth="75.0" text="Execution Count" />
            <TableColumn prefWidth="75.0" text="Average Credit Cost" />
        </columns>
      </TableView>
      <Button mnemonicParsing="false" text="Execute Program" alignment="TOP_RIGHT"/>
   </children>
</VBox>
