<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.control.Label?>
<VBox xmlns="http://javafx.com/javafx/"
      xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.components.UsersTableController">
   <children>

       <Label fx:id="usersCountLabel" text="0"/>

       <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" >
          <columnResizePolicy >
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        <columns>
          <TableColumn fx:id="colUserName" text="User Name" />
          <TableColumn fx:id="colPrograms" text="Programs Uploaded" />
            <TableColumn fx:id="colFunctions" text="Functions Added" />
            <TableColumn fx:id="colCurrentCredits" text="Current Credits" />
            <TableColumn fx:id="colUsedCredits" text="Credits Used" />
            <TableColumn fx:id="colExecutions" text="Total Executions" />
        </columns>
      </TableView>
      <Button mnemonicParsing="false" text="Unselect User" />
   </children>
</VBox>
