<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>


<VBox  xmlns="http://javafx.com/javafx/"  xmlns:fx="http://javafx.com/fxml"
       fx:controller="controllers.components.dashboard.FunctionsTableController" >
   <children>
      <TableView fx:id="functionsTable"   VBox.vgrow="ALWAYS">
          <columnResizePolicy >
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        <columns>
          <TableColumn fx:id="colName" text="Function " />
          <TableColumn fx:id="colProgramName" text="Parent Program" />
            <TableColumn fx:id="colUploader" text="Uploaded By" />
            <TableColumn fx:id="colInstCount" text="Instructions Count (Degree 0)" />
            <TableColumn fx:id="colMaxDegree" text="Max Degree" />
        </columns>
      </TableView>
      <Button fx:id="btnRunAsProgram" text="Execute Program" alignment="TOP_RIGHT"/>
   </children>
</VBox>
