<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.components.dashboardScreen.ProgramsTableController" stylesheets="@/skins/base.css" spacing="10">


<children>
      <TableView fx:id="programsTable"   VBox.vgrow="ALWAYS">
          <columnResizePolicy >
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        <columns>
          <TableColumn  fx:id="colName" text="Name" />
          <TableColumn fx:id="colUploadedBy" text="Uploaded By" />
            <TableColumn fx:id="colInstructionCount" text="Instructions Count" />
            <TableColumn fx:id="colMaxDegree" text="Max Degree" />
            <TableColumn fx:id="colRunCount" text="Execution Count" />
            <TableColumn  fx:id="colAvgCreditCost" text="Average Credit Cost" />
        </columns>
      </TableView>
      <Button fx:id="btnRunProgram" text="Execute Program" alignment="TOP_RIGHT"/>
   </children>
</VBox>
