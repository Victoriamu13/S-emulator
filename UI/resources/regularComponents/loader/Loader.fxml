<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>


<HBox spacing="10.0"
      xmlns:fx="http://javafx.com/javafx"
      fx:controller="controllers.components.dashboard.DashHeaderController"
      stylesheets="@/skins/base.css">

   <children>
      <Button fx:id="btnLoadFile" text="Load File"  minWidth="80.0" HBox.hgrow="NEVER">
         <HBox.margin>
            <Insets left="10" right="5"/>
         </HBox.margin>
      </Button>

      <TextField fx:id="filePathField"
                 promptText="No file loaded"
                 editable="false"
                 focusTraversable="false"
                 HBox.hgrow="ALWAYS"
                 styleClass="text-field">
         <HBox.margin>
            <Insets right="10"/>
         </HBox.margin>
      </TextField>

   </children>
   <padding>
      <Insets top="8.0" bottom="8.0"/>
   </padding>
</HBox>
